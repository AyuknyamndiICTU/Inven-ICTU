{
  "name": "@labpass/ui",
  "version": "0.1.0",
  "private": true,
  "description": "LabPass UI kit: accessible primitives, content states and CSS/SVG-level signature animations (DESIGN §3-§6)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@labpass/motion": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "motion": "^12.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
