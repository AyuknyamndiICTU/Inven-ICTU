{
  "name": "labpass",
  "private": true,
  "description": "ICTU LabPass — Cisco lab equipment sign-in/sign-out system",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run lint typecheck test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "contracts:check": "pnpm --filter @labpass/contracts run check",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @labpass/api run db:migrate",
    "db:seed": "pnpm --filter @labpass/api run db:seed",
    "ops:reconcile": "pnpm --filter @labpass/api run ops:reconcile",
    "evidence:check": "node scripts/evidence-check.mjs",
    "format": "prettier --write .",
    "prepare": "simple-git-hooks",
    "test:attacks": "pnpm --filter @labpass/api test:attacks",
    "test:journeys": "pnpm --filter @labpass/api test:journeys",
    "ops:restore-drill": "pwsh -NoProfile -File scripts/ops/restore-drill.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.0",
    "secretlint": "^11.2.0",
    "simple-git-hooks": "^2.13.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "secretlint --maskSecrets",
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
