# LabPass production settings (S14). Copy to deploy/.env.prod on the server (never commit it):
#   cp deploy/env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# Generate secrets on the server, e.g.  openssl rand -base64 48   (DATA_KEY: openssl rand -base64 32)
# Every value marked <...> must be replaced before the first start; the API refuses to boot with dev secrets.

# --- Release and hosts -------------------------------------------------------------------------------------
LABPASS_VERSION=1.0.0
LABPASS_DOMAIN=<labpass.ictuniversity.edu.cm>
LABPASS_ADMIN_DOMAIN=<admin.labpass.ictuniversity.edu.cm>
ACME_EMAIL=<it-support@ictuniversity.edu.cm>
TZ=Africa/Douala

# --- Database (used by postgres, api, worker, migrate, backup) ---------------------------------------------
LABPASS_DB_NAME=labpass
LABPASS_DB_USER=labpass
LABPASS_DB_PASSWORD=<generate>

# --- API secrets (rotate per docs/runbooks/secrets-rotation.md) --------------------------------------------
APP_SECRET=<generate: at least 32 characters>
UID_PEPPER=<generate: at least 32 characters; NEVER rotate without re-enrolling every card>
DATA_KEY=<generate: 32 bytes, base64>
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_LEVEL=info

# --- Origins (must match the hosts above) ------------------------------------------------------------------
ADMIN_ORIGINS=<https://admin.labpass.ictuniversity.edu.cm>
STUDENT_ORIGINS=<https://labpass.ictuniversity.edu.cm>
WEBAUTHN_RP_ID=<labpass.ictuniversity.edu.cm>
WEBAUTHN_RP_NAME=ICTU LabPass
PUBLIC_API_URL=/api
PHOTO_HOSTS=

# --- Email (school SMTP relay) -----------------------------------------------------------------------------
SMTP_HOST=<smtp.ictuniversity.edu.cm>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<labpass@ictuniversity.edu.cm>
SMTP_PASSWORD=<from IT>
SMTP_FROM=ICTU LabPass <labpass@ictuniversity.edu.cm>

# --- Push notifications (npx web-push generate-vapid-keys) -------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:labpass@ictuniversity.edu.cm
EXPO_ACCESS_TOKEN=

# --- WhatsApp / SMS provider tokens are entered in Admin → Settings (stored encrypted with DATA_KEY) ---------

# --- Backups -----------------------------------------------------------------------------------------------
# age public key of the backup custodian (age-keygen -o labpass-backup.key; keep the private key OFF the server).
BACKUP_AGE_RECIPIENT=<age1...>
BACKUP_AT=02:30
BACKUP_RETENTION_DAYS=14
# Optional Uptime Kuma push URL (e.g. http://uptime-kuma:3001/api/push/<token>); alerts when a nightly backup is missed.
BACKUP_PUSH_URL=
