# LabPass edge (S14). Caddy obtains and renews TLS certificates automatically (Let's Encrypt) for the two hosts
# below; to use an ICTU-issued certificate instead, replace the automatic TLS with `tls /certs/fullchain.pem
# /certs/privkey.pem` in each site block and mount the files read-only.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

(api_proxy) {
	# /api/* → API with the prefix removed. Socket.IO clients use path /api/socket.io, which becomes /socket.io/.
	handle_path /api/* {
		reverse_proxy api:4000 {
			health_uri /health
			health_interval 15s
		}
	}
}

# Student web app (PWA) + public API used by kiosks and phones.
{$LABPASS_DOMAIN} {
	encode zstd gzip
	import security_headers
	import api_proxy

	# Android APK downloads (S12 download page) and its SHA-256 file; drop new builds into ./downloads on the host.
	handle_path /downloads/* {
		root * /srv/downloads
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv/app
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		}
		@immutable path /_expo/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate path /sw.js /index.html /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"
		try_files {path} {path}.html /index.html
		file_server
	}
}

# Admin console. API calls go straight to the API (keeps WebSockets working); everything else to Next.js.
{$LABPASS_ADMIN_DOMAIN} {
	encode zstd gzip
	import security_headers
	import api_proxy

	handle {
		reverse_proxy admin:3100
	}
}
