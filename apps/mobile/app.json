{
  "expo": {
    "name": "LabPass",
    "slug": "labpass",
    "scheme": "labpass",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "cm.ictuniversity.labpass",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "LabPass",
      "shortName": "LabPass",
      "themeColor": "#07080A",
      "backgroundColor": "#07080A"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
