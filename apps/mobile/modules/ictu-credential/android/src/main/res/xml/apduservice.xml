<?xml version="1.0" encoding="utf-8"?>
<!-- ICTU Tap Protocol v1 AID. requireDeviceUnlock: a locked phone never receives APDUs, so it can never sign (ARCH §6). -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/labpass_hce_description"
  android:requireDeviceUnlock="true">
  <aid-group android:description="@string/labpass_hce_description" android:category="other">
    <aid-filter android:name="F0494354554C5001" />
  </aid-group>
</host-apdu-service>
