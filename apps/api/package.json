{
  "name": "@labpass/api",
  "version": "0.1.0",
  "private": true,
  "description": "LabPass API (NestJS + Fastify)",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && swc src -d dist --strip-leading-paths --copy-files",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "worker": "node -r @swc-node/register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:concurrency": "vitest run test/operations/concurrency.test.ts",
    "test:property": "vitest run test/operations/property.test.ts",
    "db:migrate": "node scripts/prisma.cjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma.cjs migrate dev",
    "db:seed": "node -r @swc-node/register prisma/seed.ts",
    "ops:reconcile": "node -r @swc-node/register src/ops/reconcile.cli.ts",
    "bench:import": "node -r @swc-node/register test/bench/import.bench.ts",
    "db:studio": "node scripts/prisma.cjs studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@labpass/config": "workspace:*",
    "@labpass/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.0",
    "@simplewebauthn/server": "^13.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.61.0",
    "exceljs": "^4.4.0",
    "fastify": "5.11.3",
    "ioredis": "^5.8.0",
    "libphonenumber-js": "^1.12.0",
    "nodemailer": "^7.0.6",
    "otplib": "^12.0.1",
    "papaparse": "^5.5.3",
    "pino": "^9.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.3.0",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
