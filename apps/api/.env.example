# LabPass API — local development. Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# ── Secrets (production must set real values; dev/test use built-in throwaway defaults) ──
# APP_SECRET=            # >= 32 chars, HMAC key for tokens, OTP hashes, signed URLs
# UID_PEPPER=            # >= 32 chars, pepper for card UID HMACs
# DATA_KEY=              # 32 bytes base64, AES-256-GCM key for secrets at rest

# ── Origins & passkeys (ARCH §7) ──
# ADMIN_ORIGINS=http://localhost:3100
# STUDENT_ORIGINS=http://localhost:3102,http://localhost:8081
# WEBAUTHN_RP_ID=localhost          # production: the LabPass domain (publicly trusted HTTPS required)
# WEBAUTHN_RP_NAME=ICTU LabPass
# COOKIE_SECURE=false               # must be true in production

# ── Email (dev: Mailpit on 1026, UI http://localhost:8026) ──
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1026
# SMTP_FROM=ICTU LabPass <labpass@ictuniversity.example>

# ── Student directory imports (ARCH §9) ──
# PHOTO_HOSTS=sis.ictuniversity.edu.cm   # hosts allowed in photo_url columns

# ── Student push notifications ──
# VAPID_PUBLIC_KEY=      # web app; generate with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:labpass@ictuniversity.example
# EXPO_ACCESS_TOKEN=     # Android app (optional)

# ── Processes ──
# WORKER_MODE=inline     # inline | separate (run `pnpm --filter @labpass/api worker`) | off (tests)
