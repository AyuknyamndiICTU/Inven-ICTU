{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["LABPASS_API_ORIGIN", "EXPO_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**", "generated/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
